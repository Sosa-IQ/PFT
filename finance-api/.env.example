# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# From Supabase: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Bypasses RLS — backend only, never expose

# Plaid credentials — from your Plaid dashboard
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox                            # sandbox | development | production

# Symmetric key for encrypting Plaid access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# CORS — comma-separated origins allowed to call this API
# For local dev: http://localhost:3000
# For production: https://your-vercel-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# AWS SES — contact form emails
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SES_FROM_EMAIL=contact@yourdomain.com     # must be verified in SES
CONTACT_TO_EMAIL=your-personal@email.com  # your personal email — never sent to clients

# RevenueCat — webhook validation secret (from RevenueCat dashboard → Integrations → Webhooks)
# Keep this for when mobile app is added. RC's Stripe integration tracks web purchases automatically.
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Stripe — from Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret  # from Stripe dashboard → Webhooks
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id      # $6.99/month, 7-day trial
STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id        # $59.99/year, 7-day trial

# Frontend URL — used for Stripe Customer Portal return URL
FRONTEND_URL=https://budgitbuddy.com
