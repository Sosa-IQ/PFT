# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# From Supabase: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Bypasses RLS — keep secret, backend only

# Transport mode: "stdio" (local, default) or "sse" (remote / EC2)
MCP_TRANSPORT=stdio

# ── stdio mode only ─────────────────────────────────────────────────────────
# Your Supabase user JWT for local testing.
# Not used in SSE mode (user authenticates via OAuth login form instead).
SUPABASE_USER_JWT=your-user-jwt-token

# ── SSE mode only ───────────────────────────────────────────────────────────
# Public URL of the deployed MCP server (used in OAuth metadata + login redirect).
MCP_SERVER_URL=https://mcp.yourdomain.com

# Port the server listens on.
PORT=8000
