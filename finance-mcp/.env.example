# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# From Supabase: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Bypasses RLS — keep secret, backend only

# Your Supabase user JWT (from the browser after logging in, or from a test token)
# Go to your Supabase dashboard → Authentication → Users → copy a JWT for testing
# In Phase 5 this will come from the MCP request headers instead.
SUPABASE_USER_JWT=your-user-jwt-token
